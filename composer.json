{
    "name": "madbox-99/laravel-locale-switcher",
    "description": "Simple locale switcher for Laravel applications using cookies.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Zoltán Tamás Szabó",
            "email": "zoli.szabok@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^2.0|^3.0"
    },
    "autoload": {
        "psr-4": {
            "MadBox\\LocaleSwitcher\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MadBox\\LocaleSwitcher\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MadBox\\LocaleSwitcher\\LocaleSwitcherServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
